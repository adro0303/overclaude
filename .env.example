# Copy to .env.local (or export these in your shell rc) and fill in real
# values there. Never commit a file with real secrets in it -- .env.local is
# gitignored.

# Where your projects live. Used by cproj/ctel in shell/aliases.zsh.
CC_BOOST_PROJECTS_DIR=$HOME/Projects

# Optional: alternative to running `/telegram:configure <token>` inside a
# Claude Code session. If set, the official telegram channel plugin picks
# this up instead of ~/.claude/channels/telegram/.env. Get the token from
# @BotFather on Telegram (send /newbot). Never hardcode this in a script.
TELEGRAM_BOT_TOKEN=
