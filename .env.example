# Copy to .env.local (or export these in your shell rc) and fill in real
# values there. Never commit a file with real secrets in it -- .env.local is
# gitignored.

# Where your projects live. Used by cproj/ctel in shell/aliases.zsh.
OVERCLAUDE_PROJECTS_DIR=$HOME/Projects

# Optional: file-count threshold above which cproj/ctel auto-wire the
# codebase-memory-mcp graph (.mcp.json) into a project. Below this, a
# project is left alone on purpose -- a standing MCP server has a fixed
# tool-schema cost every session, not worth it for a handful of files.
OVERCLAUDE_GRAPH_THRESHOLD=40

# Optional: alternative to running `/telegram:configure <token>` inside a
# Claude Code session. If set, the official telegram channel plugin picks
# this up instead of ~/.claude/channels/telegram/.env. Get the token from
# @BotFather on Telegram (send /newbot). Never hardcode this in a script.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram chat IDs for hooks/stop-notify (the
# turn-completion ping). If unset, it notifies everyone already in your
# Telegram channel's own allowFrom allowlist -- most people never need to
# set this.
TELEGRAM_NOTIFY_CHAT_IDS=
