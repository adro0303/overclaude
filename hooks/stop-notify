#!/usr/bin/env python3
"""Stop hook: a best-effort "I'm done" ping when a turn finishes --
a short completion sound plus a Telegram message with a preview of the
last response, sent to whoever is already allowed to talk to your bot.

Never blocks the Stop event: every failure path here is caught and
swallowed. No secrets are hardcoded -- the bot token is read from
~/.claude/channels/telegram/.env (chmod 600, set up via
`/telegram:configure` per the README) and the recipients come from that
same channel's own allowlist, so this reuses pairing you already did.
"""
import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request
from shutil import which

SOUND_CANDIDATES = [
    "/usr/share/sounds/freedesktop/stereo/complete.oga",
    "/usr/share/sounds/freedesktop/stereo/message.oga",
]
TELEGRAM_ENV = os.path.expanduser("~/.claude/channels/telegram/.env")
TELEGRAM_ACCESS = os.path.expanduser("~/.claude/channels/telegram/access.json")
PREVIEW_LEN = 150


def play_sound() -> None:
    """Linux + PulseAudio/PipeWire only. Silently does nothing elsewhere --
    this is a nice-to-have, not something worth failing a hook over."""
    if not which("paplay"):
        return
    for path in SOUND_CANDIDATES:
        if os.path.exists(path):
            subprocess.run(
                ["paplay", path],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
            return


def load_telegram_token() -> str | None:
    try:
        with open(TELEGRAM_ENV) as f:
            for line in f:
                if line.startswith("TELEGRAM_BOT_TOKEN="):
                    return line.strip().split("=", 1)[1] or None
    except OSError:
        return None
    return None


def telegram_chat_ids() -> list[str]:
    """TELEGRAM_NOTIFY_CHAT_IDS (comma-separated) overrides; otherwise this
    notifies everyone already in the channel's own allowFrom allowlist."""
    override = os.environ.get("TELEGRAM_NOTIFY_CHAT_IDS", "").strip()
    if override:
        return [c.strip() for c in override.split(",") if c.strip()]
    try:
        with open(TELEGRAM_ACCESS) as f:
            access = json.load(f)
        return [str(c) for c in access.get("allowFrom", [])]
    except (OSError, json.JSONDecodeError):
        return []


def last_assistant_preview(transcript_path: str) -> str:
    if not transcript_path:
        return ""
    try:
        with open(transcript_path) as f:
            lines = f.readlines()
    except OSError:
        return ""
    for line in reversed(lines):
        line = line.strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        message = entry.get("message", {})
        if entry.get("type") != "assistant" or message.get("role") != "assistant":
            continue
        for block in message.get("content", []):
            if isinstance(block, dict) and block.get("type") == "text":
                text = " ".join(block.get("text", "").split())
                if text:
                    return text[:PREVIEW_LEN]
    return ""


def send_telegram(payload: dict) -> None:
    token = load_telegram_token()
    chat_ids = telegram_chat_ids()
    if not token or not chat_ids:
        return

    project = os.path.basename(payload.get("cwd") or os.getcwd())
    preview = last_assistant_preview(payload.get("transcript_path", ""))
    text = f"✅ Claude finished ({project})"
    if preview:
        text += f": {preview}"

    for chat_id in chat_ids:
        try:
            data = urllib.parse.urlencode({"chat_id": chat_id, "text": text}).encode()
            req = urllib.request.Request(
                f"https://api.telegram.org/bot{token}/sendMessage", data=data
            )
            urllib.request.urlopen(req, timeout=4)
        except Exception:
            pass


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}

    play_sound()
    send_telegram(payload)


if __name__ == "__main__":
    main()
